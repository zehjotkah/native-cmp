{
  "name": "native-cmp-consent-log",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node test/log.test.mjs",
    "setup": "node setup.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "description": "Consent log for Native CMP: stores one entry per consent decision in your own Cloudflare account, without IP addresses.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/zehjotkah/native-cmp-consent-log.git"
  },
  "cloudflare": {
    "label": "Native CMP consent log",
    "products": [
      "Workers",
      "D1"
    ],
    "categories": [
      "storage"
    ],
    "docs_url": "https://nativecmp.com/docs#proof-of-consent",
    "bindings": {
      "EXPORT_TOKEN": {
        "description": "Token that protects the CSV export. Generate a long random value, for example with `openssl rand -base64 24`."
      }
    }
  }
}
